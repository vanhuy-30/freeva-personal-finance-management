# Copy to .env at repo root (optional) and to backend/api/.env

NODE_ENV=development
PORT=4000
API_PREFIX=api

# PostgreSQL (compose map 5434→5432; tránh Postgres native :5432)
DATABASE_URL=postgresql://freeva:freeva@localhost:5434/freeva?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# CORS — web admin local
CORS_ORIGINS=http://localhost:3001

# Logging
LOG_LEVEL=info
