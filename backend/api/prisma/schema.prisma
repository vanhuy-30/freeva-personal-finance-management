generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// App / sync schema major. Health uses SELECT 1, not this table.
model SchemaMeta {
  id        Int      @id @default(1)
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz
}

enum FinancialAccountType {
  cash
  bank
  ewallet
  credit
}

enum TransactionType {
  income
  expense
  transfer
  adjustment
  debt
  /// Money back for an expense (BE-P3-008): one positive leg, netted against the original expense's category and period.
  refund
  /// Money moved between a wallet and an investment position (BE-P4-E01): one leg, outside income/expense.
  investment
}

enum CategoryKind {
  expense
  income
  both
}

enum FxQuoteSource {
  manual
  provider
}

enum RecurringUnit {
  day
  week
  month
  year
}

/// auto posts on schedule; remind only reminds and waits for a user confirm (BE-P3-001).
enum RecurringMode {
  auto
  remind
}

enum AuditActorType {
  user
  staff
  system
}

enum AuditOutcome {
  success
  failure
  denied
}

/// Internal audit schema. Writers include staff.user_lookup, auth success, user.data_export and user.account_delete.
/// Not tamper-proof. Actor consistency and code syntax are CHECK constraints in the migration.
/// IDs deliberately have no FK. Account deletion keeps these rows.
model AuditEvent {
  id         String         @id @default(uuid()) @db.Uuid
  actorType  AuditActorType
  actorId    String?        @db.Uuid
  action     String         @db.VarChar(100)
  targetType String         @db.VarChar(50)
  targetId   String?        @db.Uuid
  outcome    AuditOutcome
  occurredAt DateTime       @default(now()) @db.Timestamptz
  createdAt  DateTime       @default(now()) @db.Timestamptz

  @@index([actorType, actorId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([occurredAt])
}

/// ISO 4217 catalog. No seed in BE-P0-001. Never store money as Float/Double.
model Currency {
  code        String @id @db.Char(3)
  minorDigits Int
  name        String

  users                 User[]                @relation("UserDefaultCurrency")
  displayUsers          User[]                @relation("UserDisplayCurrency")
  fxRatesFrom           UserFxRate[]          @relation("UserFxRateFrom")
  fxRatesTo             UserFxRate[]          @relation("UserFxRateTo")
  financialAccounts     FinancialAccount[]
  transactions          Transaction[]
  fxQuotesFrom          FxQuote[]             @relation("FxQuoteFrom")
  fxQuotesTo            FxQuote[]             @relation("FxQuoteTo")
  recurringRules        RecurringRule[]       @relation("RecurringCurrency")
  recurringCounterRules RecurringRule[]       @relation("RecurringCounterCurrency")
  budgets               Budget[]
  budgetMonths          BudgetMonth[]
  goals                 Goal[]
  loans                 Loan[]
  personalDebts         PersonalDebt[]
  investments           Investment[]
  cardInstallmentPlans  CardInstallmentPlan[]
}

model User {
  id                       String    @id @default(uuid()) @db.Uuid
  email                    String    @unique
  displayName              String?   @db.VarChar(60)
  passwordHash             String?
  emailVerifiedAt          DateTime? @db.Timestamptz
  termsAcceptedAt          DateTime? @db.Timestamptz
  termsVersion             String?   @db.VarChar(20)
  onboardingGoals          String[]  @default([])
  monthlyIncomeMinor       BigInt?
  displayCurrencyCode      String?   @db.Char(3)
  locale                   String    @default("vi")
  timezone                 String    @default("Asia/Ho_Chi_Minh")
  defaultCurrencyCode      String    @db.Char(3)
  fiscalMonthStartDay      Int       @default(1)
  version                  Int       @default(1)
  createdAt                DateTime  @default(now()) @db.Timestamptz
  updatedAt                DateTime  @updatedAt @db.Timestamptz
  categoriesInitializedAt  DateTime? @db.Timestamptz
  categoriesSupplementedAt DateTime? @db.Timestamptz
  categoryIconsRefreshedAt DateTime? @db.Timestamptz

  oauthIdentities OAuthIdentity[]
  authTokens      AuthToken[]
  sessions        AuthSession[]
  authMailJobs    AuthMailJob[]

  defaultCurrency        Currency                @relation("UserDefaultCurrency", fields: [defaultCurrencyCode], references: [code])
  financialAccounts      FinancialAccount[]
  categoryGroups         CategoryGroup[]
  categories             Category[]
  tags                   Tag[]
  feedback               Feedback[]
  transactions           Transaction[]
  fxQuotes               FxQuote[]
  fxRates                UserFxRate[]
  displayCurrency        Currency?               @relation("UserDisplayCurrency", fields: [displayCurrencyCode], references: [code])
  recurringRules         RecurringRule[]
  budget                 Budget?
  budgetMonths           BudgetMonth[]
  notificationPreference NotificationPreference?
  notifications          InAppNotification[]
  pushTokens             PushToken[]
  goals                  Goal[]
  goalEntries            GoalEntry[]
  loans                  Loan[]
  loanPayments           LoanPayment[]
  personalDebts          PersonalDebt[]
  investments            Investment[]
  investmentTrades       InvestmentTrade[]
  investmentPrices       InvestmentPrice[]
  personalDebtPayments   PersonalDebtPayment[]
  cardInstallmentPlans   CardInstallmentPlan[]
  importBatches          ImportBatch[]
}

model FinancialAccount {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @db.Uuid
  clientId            String               @db.Uuid
  name                String
  type                FinancialAccountType
  currencyCode        String               @db.Char(3)
  initialBalanceMinor BigInt
  sortOrder           Int                  @default(0)
  archivedAt          DateTime?            @db.Timestamptz
  creditLimitMinor    BigInt?
  statementCloseDay   Int?
  paymentDueDay       Int?
  minimumPaymentMinor BigInt?
  version             Int                  @default(1)
  createdAt           DateTime             @default(now()) @db.Timestamptz
  updatedAt           DateTime             @updatedAt @db.Timestamptz

  user                 User                  @relation(fields: [userId], references: [id])
  currency             Currency              @relation(fields: [currencyCode], references: [code])
  transactions         Transaction[]
  recurringSource      RecurringRule[]       @relation("RecurringSourceAccount")
  recurringCounter     RecurringRule[]       @relation("RecurringCounterAccount")
  goals                Goal[]
  loans                Loan[]
  personalDebts        PersonalDebt[]
  investmentTrades     InvestmentTrade[]
  personalDebtPayments PersonalDebtPayment[]
  cardInstallmentPlans CardInstallmentPlan[]

  @@unique([userId, clientId])
  @@index([userId, archivedAt])
}

model CategoryGroup {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  clientId   String    @db.Uuid
  name       String
  isSystem   Boolean   @default(false)
  archivedAt DateTime? @db.Timestamptz
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz

  user       User       @relation(fields: [userId], references: [id])
  categories Category[]

  @@unique([userId, clientId])
  @@index([userId])
}

model Category {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  clientId   String       @db.Uuid
  name       String
  kind       CategoryKind @default(both)
  isSystem   Boolean      @default(false)
  groupId    String?      @db.Uuid
  parentId   String?      @db.Uuid
  colorToken String?
  iconToken  String?
  archivedAt DateTime?    @db.Timestamptz
  version    Int          @default(1)
  createdAt  DateTime     @default(now()) @db.Timestamptz
  updatedAt  DateTime     @updatedAt @db.Timestamptz

  user             User                  @relation(fields: [userId], references: [id])
  group            CategoryGroup?        @relation(fields: [groupId], references: [id])
  parent           Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[]            @relation("CategoryTree")
  transactions     Transaction[]
  recurringRules   RecurringRule[]
  budgetLines      BudgetCategory[]
  budgetMonthLines BudgetMonthCategory[]

  @@unique([userId, clientId])
  @@index([userId, archivedAt])
  @@index([parentId])
}

/// Support feedback from the Góp ý screen (DS-P2-003). Text only; deleted with the account.
model Feedback {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  kind       String   @db.VarChar(10)
  topic      String   @db.VarChar(20)
  message    String   @db.VarChar(2000)
  allowReply Boolean
  appVersion String   @db.VarChar(30)
  createdAt  DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  clientId  String   @db.Uuid
  name      String
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user         User             @relation(fields: [userId], references: [id])
  transactions TransactionTag[]

  @@unique([userId, clientId])
  @@index([userId])
}

model Transaction {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  clientId        String          @db.Uuid
  type            TransactionType
  amountMinor     BigInt
  currencyCode    String          @db.Char(3)
  occurredOn      DateTime        @db.Date
  /// Optional clock time HH:mm in the user's profile timezone (BE-P2-E09). Reports still key off occurredOn.
  occurredTime    String?         @db.VarChar(5)
  accountId       String          @db.Uuid
  categoryId      String?         @db.Uuid
  transferGroupId String?         @db.Uuid
  fxQuoteId       String?         @db.Uuid
  recurringRuleId String?         @db.Uuid
  /// Set only on `refund` rows: the expense being refunded.
  refundOfId      String?         @db.Uuid
  /// Set only on rows written by a CSV import (BE-P3-011); undo soft-deletes the whole batch.
  importBatchId   String?         @db.Uuid
  notes           String?
  merchant        String?
  deletedAt       DateTime?       @db.Timestamptz
  version         Int             @default(1)
  createdAt       DateTime        @default(now()) @db.Timestamptz
  updatedAt       DateTime        @updatedAt @db.Timestamptz

  user            User                 @relation(fields: [userId], references: [id])
  account         FinancialAccount     @relation(fields: [accountId], references: [id])
  category        Category?            @relation(fields: [categoryId], references: [id])
  currency        Currency             @relation(fields: [currencyCode], references: [code])
  fxQuote         FxQuote?             @relation(fields: [fxQuoteId], references: [id])
  recurringRule   RecurringRule?       @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  refundOf        Transaction?         @relation("TransactionRefund", fields: [refundOfId], references: [id], onDelete: NoAction)
  refunds         Transaction[]        @relation("TransactionRefund")
  tags            TransactionTag[]
  installmentPlan CardInstallmentPlan?
  importBatch     ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([userId, clientId])
  @@index([userId, occurredOn])
  @@index([importBatchId])
  @@index([accountId])
  @@index([transferGroupId])
  @@index([recurringRuleId])
  @@index([refundOfId])
}

/// Default monthly spend limit (BE-P2-E02). One row per user; used when a fiscal month has no override.
model Budget {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  currencyCode    String   @db.Char(3)
  limitMinor      BigInt
  alertThresholds Int[]    @default([])
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency   Currency         @relation(fields: [currencyCode], references: [code])
  categories BudgetCategory[]
}

model BudgetCategory {
  id         String @id @default(uuid()) @db.Uuid
  budgetId   String @db.Uuid
  categoryId String @db.Uuid
  limitMinor BigInt

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([budgetId, categoryId])
  @@index([budgetId])
}

/// Per fiscal-month override. periodFrom is the inclusive start of the month (resolvePeriod month.from).
model BudgetMonth {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  periodFrom      DateTime @db.Date
  periodTo        DateTime @db.Date
  currencyCode    String   @db.Char(3)
  limitMinor      BigInt
  alertThresholds Int[]    @default([])
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency   Currency              @relation(fields: [currencyCode], references: [code])
  categories BudgetMonthCategory[]

  @@unique([userId, periodFrom])
  @@index([userId])
}

model BudgetMonthCategory {
  id         String @id @default(uuid()) @db.Uuid
  monthId    String @db.Uuid
  categoryId String @db.Uuid
  limitMinor BigInt

  month    BudgetMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  category Category    @relation(fields: [categoryId], references: [id])

  @@unique([monthId, categoryId])
  @@index([monthId])
}

/// Template for automatic income/expense/transfer posts (BE-P2-E01). Money is signed BigInt minor units.
model RecurringRule {
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String          @db.Uuid
  clientId            String          @db.Uuid
  type                TransactionType
  unit                RecurringUnit
  interval            Int
  amountMinor         BigInt
  currencyCode        String          @db.Char(3)
  /// Required for auto; optional default wallet for remind.
  accountId           String?         @db.Uuid
  categoryId          String?         @db.Uuid
  counterAccountId    String?         @db.Uuid
  counterAmountMinor  BigInt?
  counterCurrencyCode String?         @db.Char(3)
  fxRate              Decimal?        @db.Decimal(18, 8)
  startDate           DateTime        @db.Date
  endDate             DateTime?       @db.Date
  nextExecutionDate   DateTime        @db.Date
  active              Boolean         @default(true)
  mode                RecurringMode   @default(auto)
  /// Bill-style label, required for remind.
  name                String?         @db.VarChar(80)
  amountKind          BillAmountKind  @default(fixed)
  remindDaysBefore    Int             @default(3)
  version             Int             @default(1)
  createdAt           DateTime        @default(now()) @db.Timestamptz
  updatedAt           DateTime        @updatedAt @db.Timestamptz

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         FinancialAccount?     @relation("RecurringSourceAccount", fields: [accountId], references: [id])
  counterAccount  FinancialAccount?     @relation("RecurringCounterAccount", fields: [counterAccountId], references: [id])
  category        Category?             @relation(fields: [categoryId], references: [id])
  currency        Currency              @relation("RecurringCurrency", fields: [currencyCode], references: [code])
  counterCurrency Currency?             @relation("RecurringCounterCurrency", fields: [counterCurrencyCode], references: [code])
  occurrences     RecurringOccurrence[]
  transactions    Transaction[]

  @@unique([userId, clientId])
  @@index([userId, active, nextExecutionDate])
}

/// How a recurring rule's amount is known: fixed, or estimated and confirmed when paid.
enum BillAmountKind {
  fixed
  estimated
}

model RecurringOccurrence {
  id                  String   @id @default(uuid()) @db.Uuid
  ruleId              String   @db.Uuid
  occurredOn          DateTime @db.Date
  transactionClientId String   @db.Uuid
  counterClientId     String?  @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz

  rule RecurringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, occurredOn])
  @@index([ruleId])
}

/// Per-user notification toggles and quiet hours (BE-P2-E05). Unavailable kinds stay off.
model NotificationPreference {
  userId             String   @id @db.Uuid
  budgetEnabled      Boolean  @default(true)
  goalEnabled        Boolean  @default(false)
  debtEnabled        Boolean  @default(false)
  cardEnabled        Boolean  @default(true)
  recurringEnabled   Boolean  @default(true)
  monthReviewEnabled Boolean  @default(false)
  insightEnabled     Boolean  @default(false)
  dailyLogEnabled    Boolean  @default(false)
  /// Local reminder time HH:mm in the profile timezone (BE-P3-006).
  dailyLogTime       String   @default("20:00") @db.VarChar(5)
  quietHoursEnabled  Boolean  @default(false)
  quietStart         String   @default("22:00") @db.VarChar(5)
  quietEnd           String   @default("07:00") @db.VarChar(5)
  version            Int      @default(1)
  createdAt          DateTime @default(now()) @db.Timestamptz
  updatedAt          DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationKind {
  budget
  goal
  debt
  card
  recurring
  month_review
  insight
  security
  daily_log
}

/// In-app inbox row. DedupeKey prevents retries from duplicating the same alert.
model InAppNotification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  kind      NotificationKind
  dedupeKey String           @db.VarChar(160)
  titleKey  String           @db.VarChar(64)
  bodyKey   String           @db.VarChar(64)
  params    Json             @default("{}")
  createdAt DateTime         @default(now()) @db.Timestamptz
  readAt    DateTime?        @db.Timestamptz
  /// Set when the FCM push was claimed (BE-P2-015). Null = still to push.
  pushedAt  DateTime?        @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([pushedAt, createdAt])
}

enum PushPlatform {
  ios
  android
}

/// FCM registration token bound to one login session (BE-P2-015). Deleted with the session or user.
model PushToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  sessionId String       @unique @db.Uuid
  token     String       @unique @db.VarChar(4096)
  platform  PushPlatform
  createdAt DateTime     @default(now()) @db.Timestamptz
  updatedAt DateTime     @updatedAt @db.Timestamptz

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TransactionTag {
  transactionId String @db.Uuid
  tagId         String @db.Uuid

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
}

model FxQuote {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  clientId  String        @db.Uuid
  fromCode  String        @db.Char(3)
  toCode    String        @db.Char(3)
  rate      Decimal       @db.Decimal(18, 8)
  quotedAt  DateTime      @db.Timestamptz
  source    FxQuoteSource
  version   Int           @default(1)
  createdAt DateTime      @default(now()) @db.Timestamptz
  updatedAt DateTime      @updatedAt @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id])
  fromCurrency Currency      @relation("FxQuoteFrom", fields: [fromCode], references: [code])
  toCurrency   Currency      @relation("FxQuoteTo", fields: [toCode], references: [code])
  transactions Transaction[]

  @@unique([userId, clientId])
  @@index([userId, quotedAt])
}

/// BE-P2-013: user-typed rate, used only to show converted amounts. Never touches the ledger.
/// One row per direction; the opposite direction is never derived. CHECKs in the migration.
model UserFxRate {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  fromCode  String   @db.Char(3)
  toCode    String   @db.Char(3)
  rate      Decimal  @db.Decimal(18, 8)
  quotedAt  DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user         User     @relation(fields: [userId], references: [id])
  fromCurrency Currency @relation("UserFxRateFrom", fields: [fromCode], references: [code])
  toCurrency   Currency @relation("UserFxRateTo", fields: [toCode], references: [code])

  @@unique([userId, fromCode, toCode])
}

// Auth data is server-owned, outside the mobile sync model.
enum AuthTokenPurpose {
  verify_email
  reset_password
}

model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique @db.Char(64)
  expiresAt DateTime         @db.Timestamptz
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose])
  @@index([expiresAt])
}

model AuthSession {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  tokenHash String     @unique @db.Char(64)
  createdAt DateTime   @default(now()) @db.Timestamptz
  expiresAt DateTime   @db.Timestamptz
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushToken PushToken?

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id @db.Char(64)
  count     Int
  expiresAt DateTime @db.Timestamptz

  @@index([expiresAt])
}

// Durable SMTP outbox: encrypted token, no plaintext credentials stored.
model AuthMailJob {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  purpose        AuthTokenPurpose
  encryptedToken String
  expiresAt      DateTime         @db.Timestamptz
  availableAt    DateTime         @default(now()) @db.Timestamptz
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose])
  @@index([availableAt])
}

// BE-P1-003: stable provider identity; never merge users by email.
enum OAuthProvider {
  google
  apple
}

model OAuthIdentity {
  id       String        @id @default(uuid()) @db.Uuid
  provider OAuthProvider
  subject  String        @db.VarChar(255)
  userId   String        @db.Uuid
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
}

model OAuthChallenge {
  tokenHash String        @id @db.Char(64)
  provider  OAuthProvider
  expiresAt DateTime      @db.Timestamptz

  @@index([expiresAt])
}

enum GoalKind {
  emergency
  home
  car
  travel
  education
  wedding
  retirement
  custom
}

enum GoalEntryKind {
  contribute
  withdraw
}

/// Savings goal (BE-P3-E01). currentMinor is stored; every change goes through GoalEntry
/// (a balanced transfer when money moves between wallets) or an AuditEvent when the number is only corrected.
model Goal {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @db.Uuid
  clientId                 String    @db.Uuid
  kind                     GoalKind
  name                     String    @db.VarChar(80)
  currencyCode             String    @db.Char(3)
  targetMinor              BigInt
  currentMinor             BigInt    @default(0)
  targetDate               DateTime? @db.Date
  accountId                String    @db.Uuid
  monthlyContributionMinor BigInt?
  icon                     String    @db.VarChar(30)
  colorToken               String?   @db.VarChar(40)
  archivedAt               DateTime? @db.Timestamptz
  version                  Int       @default(1)
  createdAt                DateTime  @default(now()) @db.Timestamptz
  updatedAt                DateTime  @updatedAt @db.Timestamptz

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  FinancialAccount @relation(fields: [accountId], references: [id])
  currency Currency         @relation(fields: [currencyCode], references: [code])
  entries  GoalEntry[]

  @@unique([userId, clientId])
  @@index([userId, archivedAt])
}

model GoalEntry {
  id                  String        @id @default(uuid()) @db.Uuid
  goalId              String        @db.Uuid
  userId              String        @db.Uuid
  clientId            String        @db.Uuid
  kind                GoalEntryKind
  amountMinor         BigInt
  /// Leg clientId of the transfer behind this entry; null when no money moved between wallets.
  transactionClientId String?       @db.Uuid
  occurredOn          DateTime      @db.Date
  createdAt           DateTime      @default(now()) @db.Timestamptz

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([goalId, createdAt])
}

enum LoanKind {
  card
  personal
  mortgage
  other
}

enum LoanFrequency {
  weekly
  monthly
  quarterly
  yearly
}

/// Loan / debt (BE-P3-E02). outstandingMinor is stored; every change goes through LoanPayment
/// (expense transactions for principal and interest) or an AuditEvent when the number is only corrected.
model Loan {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  clientId         String        @db.Uuid
  kind             LoanKind
  name             String        @db.VarChar(80)
  currencyCode     String        @db.Char(3)
  principalMinor   BigInt
  outstandingMinor BigInt
  /// Annual interest rate in basis points (1200 = 12,00%).
  interestRateBps  Int           @default(0)
  installmentMinor BigInt?
  frequency        LoanFrequency @default(monthly)
  startDate        DateTime      @db.Date
  endDate          DateTime?     @db.Date
  nextDueDate      DateTime?     @db.Date
  accountId        String?       @db.Uuid
  archivedAt       DateTime?     @db.Timestamptz
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @db.Timestamptz
  updatedAt        DateTime      @updatedAt @db.Timestamptz

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  FinancialAccount? @relation(fields: [accountId], references: [id])
  currency Currency          @relation(fields: [currencyCode], references: [code])
  payments LoanPayment[]

  @@unique([userId, clientId])
  @@index([userId, archivedAt])
}

model LoanPayment {
  id                           String   @id @default(uuid()) @db.Uuid
  loanId                       String   @db.Uuid
  userId                       String   @db.Uuid
  clientId                     String   @db.Uuid
  principalMinor               BigInt
  interestMinor                BigInt
  /// Leg clientIds behind this payment: principal = one-leg `debt` row, interest = expense (null when that part is zero).
  principalTransactionClientId String?  @db.Uuid
  interestTransactionClientId  String?  @db.Uuid
  paidOn                       DateTime @db.Date
  createdAt                    DateTime @default(now()) @db.Timestamptz

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([loanId, paidOn])
}

enum PersonalDebtDirection {
  lent
  borrowed
}

/// Lend / borrow between people, no interest (BE-P3-007). Money moves through one-leg `debt` transactions,
/// never income or expense. outstandingMinor is stored; changes go through PersonalDebtPayment.
model PersonalDebt {
  id                  String                @id @default(uuid()) @db.Uuid
  userId              String                @db.Uuid
  clientId            String                @db.Uuid
  direction           PersonalDebtDirection
  counterparty        String                @db.VarChar(80)
  currencyCode        String                @db.Char(3)
  principalMinor      BigInt
  outstandingMinor    BigInt
  accountId           String                @db.Uuid
  /// Leg clientId of the transaction that moved the money out of / into the wallet.
  transactionClientId String                @db.Uuid
  occurredOn          DateTime              @db.Date
  dueDate             DateTime?             @db.Date
  note                String?               @db.VarChar(500)
  archivedAt          DateTime?             @db.Timestamptz
  version             Int                   @default(1)
  createdAt           DateTime              @default(now()) @db.Timestamptz
  updatedAt           DateTime              @updatedAt @db.Timestamptz

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  FinancialAccount      @relation(fields: [accountId], references: [id])
  currency Currency              @relation(fields: [currencyCode], references: [code])
  payments PersonalDebtPayment[]

  @@unique([userId, clientId])
  @@index([userId, archivedAt])
}

model PersonalDebtPayment {
  id                  String   @id @default(uuid()) @db.Uuid
  debtId              String   @db.Uuid
  userId              String   @db.Uuid
  clientId            String   @db.Uuid
  accountId           String   @db.Uuid
  amountMinor         BigInt
  transactionClientId String   @db.Uuid
  paidOn              DateTime @db.Date
  createdAt           DateTime @default(now()) @db.Timestamptz

  debt    PersonalDebt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account FinancialAccount @relation(fields: [accountId], references: [id])

  @@unique([userId, clientId])
  @@index([debtId, paidOn])
}

enum CardInstallmentStatus {
  active
  closed
}

/// Schedule-only installment plan over one expense on a credit wallet (BE-P3-009). Moves no money:
/// the purchase stays one expense; paying the card is an ordinary transfer.
model CardInstallmentPlan {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String                @db.Uuid
  clientId         String                @db.Uuid
  transactionId    String                @unique @db.Uuid
  accountId        String                @db.Uuid
  currencyCode     String                @db.Char(3)
  totalMinor       BigInt
  /// Per period; the last period takes what is left so the periods always add up to totalMinor.
  installmentMinor BigInt
  installmentCount Int
  firstDueOn       DateTime              @db.Date
  status           CardInstallmentStatus @default(active)
  closedAt         DateTime?             @db.Timestamptz
  version          Int                   @default(1)
  createdAt        DateTime              @default(now()) @db.Timestamptz
  updatedAt        DateTime              @updatedAt @db.Timestamptz

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     FinancialAccount @relation(fields: [accountId], references: [id])
  currency    Currency         @relation(fields: [currencyCode], references: [code])
  transaction Transaction      @relation(fields: [transactionId], references: [id])

  @@unique([userId, clientId])
  @@index([userId, accountId, status])
}

/// One CSV import (BE-P3-011). Transactions it created point back here through Transaction.importBatchId.
model ImportBatch {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  clientId       String    @db.Uuid
  preset         String    @db.VarChar(20)
  rowCount       Int
  createdCount   Int
  duplicateCount Int
  invalidCount   Int
  undoneAt       DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now()) @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, clientId])
  @@index([userId, createdAt])
}

enum InvestmentKind {
  gold
  stock
  fund
  savings_deposit
  real_estate
  crypto
}

enum InvestmentTradeSide {
  buy
  sell
}

/// A tracked position (BE-P4-E01, ADR 014). Kept apart from wallet balances; money moves through one-leg `investment` transactions.
/// costBasisMinor is the weighted-average cost of the quantity still held.
model Investment {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  clientId        String         @db.Uuid
  kind            InvestmentKind
  name            String         @db.VarChar(80)
  currencyCode    String         @db.Char(3)
  /// Unit of `quantity` and of prices: chi | luong (gold), share, unit, coin, deposit, property.
  unit            String         @db.VarChar(16)
  quantity        Decimal        @db.Decimal(28, 8)
  costBasisMinor  BigInt
  /// Savings deposit only: annual simple rate in bps, start and maturity dates.
  interestRateBps Int?
  startDate       DateTime?      @db.Date
  maturityDate    DateTime?      @db.Date
  note            String?        @db.VarChar(500)
  archivedAt      DateTime?      @db.Timestamptz
  version         Int            @default(1)
  createdAt       DateTime       @default(now()) @db.Timestamptz
  updatedAt       DateTime       @updatedAt @db.Timestamptz

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency Currency          @relation(fields: [currencyCode], references: [code])
  trades   InvestmentTrade[]
  prices   InvestmentPrice[]

  @@unique([userId, clientId])
  @@index([userId, archivedAt])
}

model InvestmentTrade {
  id                  String              @id @default(uuid()) @db.Uuid
  investmentId        String              @db.Uuid
  userId              String              @db.Uuid
  clientId            String              @db.Uuid
  side                InvestmentTradeSide
  quantity            Decimal             @db.Decimal(28, 8)
  amountMinor         BigInt
  /// Sell only: proceeds minus the cost basis removed (null for buys).
  realizedMinor       BigInt?
  /// Null for a buy the user already owned before using the app: no wallet leg (BE-P4-E03).
  accountId           String?             @db.Uuid
  transactionClientId String?             @db.Uuid
  tradedOn            DateTime            @db.Date
  note                String?             @db.VarChar(500)
  createdAt           DateTime            @default(now()) @db.Timestamptz

  investment Investment        @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([userId, clientId])
  @@index([investmentId, tradedOn])
}

/// Hand-entered price per one unit (v1: source is always `manual`).
model InvestmentPrice {
  id           String   @id @default(uuid()) @db.Uuid
  investmentId String   @db.Uuid
  userId       String   @db.Uuid
  clientId     String   @db.Uuid
  priceMinor   BigInt
  source       String   @default("manual") @db.VarChar(16)
  quotedAt     DateTime @db.Timestamptz
  createdAt    DateTime @default(now()) @db.Timestamptz

  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([investmentId, quotedAt])
}

/// BE-P5-E08: server feature flag state. Definitions (key list, meaning) live in
/// code (`app-config-registry.ts`); a missing row means the flag is off.
model FeatureFlag {
  key        String   @id @db.VarChar(64)
  enabled    Boolean  @default(false)
  /// Users who always get the flag while it is enabled.
  userIds    String[] @default([]) @db.Uuid
  percentage Int      @default(0) @db.SmallInt
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt @db.Timestamptz
  updatedBy  String   @db.Uuid
}

/// BE-P5-E08: config value edited by staff. A missing row means the code default.
model AppConfigValue {
  key       String   @id @db.VarChar(64)
  value     Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz
  updatedBy String   @db.Uuid
}

/// BE-P5-E08: before/after of every flag or config change (AuditEvent has no payload).
model AppConfigChange {
  id         String   @id @default(uuid()) @db.Uuid
  kind       String   @db.VarChar(10)
  key        String   @db.VarChar(64)
  before     Json?
  after      Json?
  actorId    String   @db.Uuid
  occurredAt DateTime @default(now()) @db.Timestamptz

  @@index([key, occurredAt])
}

/// BE-P5-E08: one row (id 1); `version` goes up on every flag or config change.
model AppConfigMeta {
  id        Int      @id @default(1)
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz
}
