generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Placeholder until BE-P0-001. Never store money as Float/Double.
model SchemaMeta {
  id        Int      @id @default(1)
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}
