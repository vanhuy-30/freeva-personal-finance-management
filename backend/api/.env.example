NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://freeva:freeva@localhost:5434/freeva?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=info
STAFF_AUTH_TOKEN=replace-with-a-long-random-token
STAFF_ACTOR_ID=11111111-1111-4111-8111-111111111111

# Staging (Render): đặt trên dashboard — xem docs/infrastructure/staging.md
# NODE_ENV=staging
# DATABASE_URL=<from Render Postgres>
# CORS_ORIGINS=https://<vercel-admin-host>
# PORT do platform set

# Auth/email — MOB-P1-001. Generate AUTH_SECRET_KEY once with openssl rand -hex 32.
# Never commit real keys. Local Mailhog is the default for this example.
AUTH_SECRET_KEY=replace-with-64-hex-characters
MAIL_PROVIDER=smtp
MAIL_FROM="Freeva <noreply@freeva.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Resend (staging): replace the settings above with these values.
# Resend test sender: deliver only to the email used for your Resend account.
# Store the real API key only in a secret/.env; verify a domain before sending to other users.
# MAIL_PROVIDER=resend
# MAIL_FROM="Freeva <onboarding@resend.dev>"
# SMTP_PORT=2465
# RESEND_API_KEY=
# Resend always uses TLS, including in development. 2465 is implicit TLS.
# Generic SMTP: TLS required outside NODE_ENV=development/test; SMTP_SECURE
# optionally selects implicit TLS for custom ports. SMTP_FROM is a legacy alias.

# BE-P1-003: comma-separated provider client IDs; empty disables provider.
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=
