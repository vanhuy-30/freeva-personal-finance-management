NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://freeva:freeva@localhost:5434/freeva?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=info
STAFF_AUTH_TOKEN=replace-with-a-long-random-token
STAFF_ACTOR_ID=11111111-1111-4111-8111-111111111111

# Staging (Render): đặt trên dashboard — xem docs/infrastructure/staging.md
# NODE_ENV=staging
# DATABASE_URL=<from Render Postgres>
# CORS_ORIGINS=https://<vercel-admin-host>
# PORT do platform set

# Phase 1 auth: generate with `openssl rand -hex 32`; never commit the real key.
AUTH_SECRET_KEY=replace-with-64-hex-characters
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Freeva <noreply@freeva.local>
# SMTP_USER=
# SMTP_PASSWORD=
# Outside NODE_ENV=development/test SMTP requires TLS (STARTTLS or port 465).
