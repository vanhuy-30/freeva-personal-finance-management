{
  "name": "freeva-personal-finance-management",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "pnpm install",
    "api": "pnpm --filter @freeva/api start:dev",
    "api:build": "pnpm --filter @freeva/api build",
    "admin": "pnpm --filter @freeva/web-admin dev",
    "admin:build": "pnpm --filter @freeva/web-admin build",
    "admin:lint": "pnpm --filter @freeva/web-admin lint",
    "test:money": "pnpm --filter @freeva/api test -- money"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "unrs-resolver"
    ],
    "overrides": {
      "multer": "2.4.0",
      "proxy-addr": "2.0.8",
      "qs": "6.16.0",
      "brace-expansion@^5": "5.0.12",
      "fast-uri@^3": "3.1.8",
      "sharp@0.35.4": "0.35.5",
      "source-map-js@1.2.1": "1.2.2"
    }
  }
}
