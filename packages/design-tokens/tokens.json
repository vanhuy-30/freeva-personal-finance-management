      "fabNotch": 6,
      "height": "{size.nav}",
      "elevation": "{elevation.2}"
    },
    "card": { "bg": "{semantic.color.bg.surface}", "radius": "{radius.xl}", "elevation": "{elevation.1}" },
    "list": { "bg": "{semantic.color.bg.surface}", "radius": "{radius.lg}", "divider": "{semantic.color.border.divider}", "rowHeight": "{size.row}" },
    "sheet": { "bg": "{semantic.color.bg.canvas}", "handle": "{semantic.color.border.strong}", "radius": "{radius.sheet}", "scrim": "{semantic.color.bg.scrim}" },
